# last30days-cn (TikHub 版) 配置
# 放到 ~/.config/last30days-cn/.env 或 <工作目录>/.claude/last30days-cn.env
# 权限必须 600：chmod 600 <文件>
# 优先级：进程环境变量 > 项目级 .claude/last30days-cn.env > 全局 ~/.config/last30days-cn/.env

# ── 主力依赖 ───────────────────────────────────────────────
# 微博 / 小红书 / B站 / 微信公众号 / 抖音 五个源共用。
# 没有它，除 B站外的四个源都会被判为不可用并跳过。
# 注册：https://tikhub.io   $0.001/次，非 200 不计费，注册送额度。
TIKHUB_API_KEY=

# ── 可选 ──────────────────────────────────────────────────
# 知乎登录 cookie。不配且没装 Playwright 时，知乎源判为不可用
# （TikHub 没有知乎综合搜索端点，无从替代）。
ZHIHU_COOKIE=

# 百度搜索 API。两个都配齐才会启用百度源——抓页路径会被安全验证拦截，
# 拦下后只剩 Bing 兜底，返回没有发布时间的常青内容，故默认不启用。
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 微博开放平台 token。TikHub 已覆盖微博且支持任意时间区间，通常不需要。
WEIBO_ACCESS_TOKEN=

# 极速数据第三方微信搜索。TikHub 搜一搜已覆盖且更正规，通常不需要。
WECHAT_API_KEY=

# ── 行为开关 ───────────────────────────────────────────────
# 默认源集（逗号分隔）。不设则按查询类型自动挑选。
# LAST30DAYS_DEFAULT_SEARCH=weibo,xiaohongshu,bilibili,wechat

# 从启用集合中排除指定源。
# EXCLUDE_SOURCES=douyin

# 报告落点目录。
# LAST30DAYS_MEMORY_DIR=

# 强制跑被闸门判为不可用的源（调试用，正常别开——它们只会返回搜索引擎兜底的噪音）。
# LAST30DAYS_FORCE_SOURCES=1

# 自托管 xiaohongshu-mcp 地址（没有 TIKHUB_API_KEY 时的回退路径）。
# 引擎默认值是 host.docker.internal:18060，本机裸跑要改成 localhost。
# XIAOHONGSHU_API_BASE=http://localhost:18060

# 完全关闭浏览器爬虫模式（旧系统或无 Playwright 时）。
# LAST30DAYS_DISABLE_BROWSER=1
